{
  "manifest_version": 3,
  "name": "Carrier Sales Assistant Engine",
  "version": "6.0",
  "description": "Frame-Broadcasting Carrier Sales Automation Engine",
  "permissions": ["activeTab", "scripting", "tabs", "webNavigation", "storage"],
  "host_permissions": [
    "https://rtcy.aljex.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://outlook.live.com/*",
        "https://mail.google.com/*",
        "https://*.office.com/*",
        "https://*.office365.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://rtcy.aljex.com/*"],
      "js": ["aljex_listener.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ]
}